    void my_Py_XINCREF(PyObject* op);
    void my_Py_XDECREF(PyObject* op);
    int my_PyModule_Check(PyObject *op);

    Py_ssize_t my_Py_REFCNT(PyObject* op);
    _typeobject* my_Py_TYPE(PyObject* op);
