language = C++

headers = patchlevel.h   Python.h pyport.h  python_export.h source/YanAPI.h   \
     longobject.h  \
    expat.h ncurses.h curses.h unctrl.h expat_external.h \
        \
    Python-ast.h abstract.h accu.h  asdl.h \
    bitset.h  bltinmodule.h boolobject.h  bytearrayobject.h  bytes_methods.h  bytesobject.h \
    cellobject.h  ceval.h classobject.h  code.h  codecs.h compile.h complexobject.h \
    datetime.h  descrobject.h  dictobject.h dtoa.h dynamic_annotations.h \
    enumobject.h errcode.h eval.h fileobject.h fileutils.h \
    floatobject.h frameobject.h funcobject.h genobject.h   grammar.h import.h \
    intrcheck.h \
    iterobject.h \
    listobject.h \
    longintrepr.h \
    marshal.h \
    memoryobject.h \
    metagrammar.h \
    methodobject.h \
    modsupport.h \
    moduleobject.h \
    namespaceobject.h \
    node.h \
    ast.h \
    object.h \
    objimpl.h \
    odictobject.h \
    opcode.h \
    osdefs.h \
    parsetok.h \
    pgen.h \
    pgenheaders.h \
    py_curses.h \
    pyarena.h \
    pyatomic.h \
    pycapsule.h \
    pyconfig.h \
    pyctype.h \
    pydebug.h \
    pyerrors.h \
    pyexpat.h \
    pyfpe.h \
    pyhash.h \
    pylifecycle.h \
    pymacconfig.h \
    pymacro.h \
    pymath.h \
    pymem.h \
    pystate.h \
    pystrcmp.h \
    pystrhex.h \
    pystrtod.h \
    pythonrun.h \
    pythread.h \
    pytime.h \
    rangeobject.h \
    setobject.h \
    sliceobject.h \
    structmember.h \
    structseq.h \
    symtable.h \
    sysmodule.h \
    token.h \
    traceback.h \
    tupleobject.h \
    typeslots.h \
    ucnhash.h \
    unicodeobject.h \
    warnings.h \
    weakrefobject.h
linkerOpts = -lstdc++ -lyanapi -Lpython3 -Lexpat -Lz



# 补充函数
